# =========================
# ADWETY Frontend .gitignore
# Place this file inside Frontend folder
# =========================

# Dependencies
node_modules/

# Environment files - keep real secrets local only
.env
.env.*
!.env.example

# Vite/React build and cache
dist/
build/
.vite/
.cache/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test/Coverage
coverage/
.nyc_output/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo
