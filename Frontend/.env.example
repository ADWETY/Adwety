VITE_PORT=6501
VITE_API_BASE_URL=http://localhost:6500/api
VITE_APP_NAME=ADWETY Dashboard
VITE_ENABLE_DEMO_AUTH=false
VITE_DEFAULT_ROLE=super_admin

# Public emails only. Do not put passwords in Frontend env because Vite env is exposed to browser.
VITE_OWNER_EMAIL=owner@adwety.app
VITE_OWNER_NAME=System Owner
VITE_SUPER_ADMIN_EMAIL=admin@adwety.app
VITE_SUPER_ADMIN_NAME=Super Admin
VITE_PHARMACY_ADMIN_EMAIL=pharmacy@adwety.app
VITE_PHARMACY_ADMIN_NAME=BlueCare Manager
VITE_SUPPORT_ADMIN_EMAIL=support@adwety.app
VITE_SUPPORT_ADMIN_NAME=Support Admin
VITE_USER_EMAIL=mona@adwety.app
VITE_USER_NAME=ADWETY User
VITE_DEMO_PHARMACY_NAME=BlueCare Pharmacy

# UI / feature flags
VITE_MAX_UPLOAD_SIZE_MB=10
VITE_ENABLE_AI_SCAN=true
VITE_ENABLE_LIVE_NOTIFICATIONS=true

# AI visibility flags for dashboard only. Real secrets stay in Backend/.env only.
VITE_AI_PROVIDER=gemini
VITE_GEMINI_MODEL=gemini-2.5-flash
VITE_CUSTOM_AI_LABEL=Future Custom Model
