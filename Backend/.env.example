########################################
# ADWETY BACKEND ENVIRONMENT VARIABLES #
########################################

# Ports
BACKEND_PORT=6500
FRONTEND_PORT=6501
FLUTTER_WEB_PORT=6502

# URLs
BACKEND_BASE_URL=http://localhost:6500
BACKEND_API_BASE_URL=http://localhost:6500/api/v1
FRONTEND_BASE_URL=http://localhost:6501
FRONTEND_PUBLIC_URL=http://127.0.0.1:6501
CORS_ORIGINS=http://localhost:6501,http://127.0.0.1:6501
FLUTTER_API_BASE_URL=http://10.0.2.2:6500/api/v1

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/adwety_dev
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/adwety_test

# Auth
JWT_SECRET=replace_with_64_plus_random_characters_generated_by_openssl_rand_hex_32
JWT_EXPIRES_IN=2h
BCRYPT_SALT_ROUNDS=12
ENABLE_DEMO_AUTH=false

# OTP Security
REQUIRE_REGISTER_OTP=true
REQUIRE_LOGIN_OTP=false
REQUIRE_PASSWORD_RESET_OTP=true
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
# email or sms. In development both are logged in terminal unless you connect real providers.
OTP_DELIVERY_CHANNEL=email
SMS_PROVIDER=console
SMS_FROM=ADWETY

# Seed accounts. Keep these in .env only; they are not hardcoded in code.
SEED_FORCE_RESET=false
SEED_SUPER_ADMIN_EMAIL=admin@adwety.app
SEED_SUPER_ADMIN_PASSWORD=replace_with_secure_super_admin_password
SEED_PHARMACY_ADMIN_EMAIL=pharmacy@adwety.app
SEED_PHARMACY_ADMIN_PASSWORD=replace_with_secure_pharmacy_admin_password
SEED_SUPPORT_ADMIN_EMAIL=support@adwety.app
SEED_SUPPORT_ADMIN_PASSWORD=replace_with_secure_support_admin_password
SEED_DEMO_USER_EMAIL=mona@adwety.app
SEED_DEMO_USER_PASSWORD=replace_with_secure_demo_user_password

# Uploads
UPLOAD_DIR=private_uploads
MAX_FILE_SIZE_MB=5

# AI Provider Selection
AI_PROVIDER=gemini
AI_TIMEOUT_MS=30000
AI_FALLBACK_ENABLED=true

# Gemini
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Custom AI Provider
CUSTOM_AI_API_URL=http://localhost:6600/v1/prescription/extract
CUSTOM_AI_API_KEY=replace_with_custom_model_key
CUSTOM_AI_MODEL=adwety-prescription-model-v1

# Optional Mail
SMTP_HOST=localhost
SMTP_PORT=6503
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@adwety.local

# Frontend placeholders
VITE_API_BASE_URL=http://localhost:6500/api/v1
VITE_APP_NAME=ADWETY Dashboard
