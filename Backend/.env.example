NODE_ENV=development
PORT=6500
MONGODB_URI=mongodb://127.0.0.1:27017/adwety_dev

# Production: use unique random values, each at least 64 characters.
JWT_SECRET=replace-with-random-64-plus-character-secret
OTP_HASH_SECRET=replace-with-another-random-64-plus-character-secret
REFRESH_TOKEN_SECRET=replace-with-another-random-64-plus-character-secret
CSRF_SECRET=replace-with-another-random-64-plus-character-secret
PASSWORD_PEPPER=replace-with-another-random-64-plus-character-secret
DATA_ENCRYPTION_KEY=replace-with-64-hex-or-long-random-secret
MFA_ENCRYPTION_KEY=replace-with-64-hex-or-long-random-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
ACCESS_COOKIE_NAME=adwety_access
REFRESH_COOKIE_NAME=adwety_refresh
CSRF_COOKIE_NAME=adwety_csrf
# For separate app/api subdomains use the shared parent, e.g. .adwetycare.me
CSRF_COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
COOKIE_PATH=/api/v1
BCRYPT_SALT_ROUNDS=12
PASSWORD_BREACH_CHECK=optional
PASSWORD_BREACH_TIMEOUT_MS=4000

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_DEV_CONSOLE=false
MFA_ISSUER=Adwety Care
MFA_CHALLENGE_MINUTES=10
MFA_MAX_ATTEMPTS=5
MFA_REAUTH_MINUTES=10

# Redis is mandatory in production. For local development it can be omitted.
REDIS_URL=redis://:change-me@127.0.0.1:6379
REDIS_REQUIRED=false
RATE_LIMIT_PREFIX=adwety:rl

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Adwety <no-reply@example.com>
SMTP_TIMEOUT_MS=10000
SMTP_REJECT_UNAUTHORIZED=true

CORS_ORIGINS=http://localhost:6501,http://127.0.0.1:6501
CORS_ALLOW_NO_ORIGIN=true
# Production must use the exact number of trusted reverse-proxy hops (for example 1 for Nginx).
# Never use TRUST_PROXY=true in production.
TRUST_PROXY=false
TRUST_PROXY_REQUIRED=false

# Canonical API is /api/v1. Compatibility aliases should be false in production.
ENABLE_API_ALIAS=false
ENABLE_MOBILE_V1_ALIAS=false
ENABLE_LEGACY_DASHBOARD_ROUTES=false
ENABLE_DASHBOARD_ALIAS=false
API_SUNSET_AT=2026-12-31T23:59:59Z
MAX_FILE_SIZE_MB=5
MAX_IMAGE_PIXELS=20000000
MAX_PDF_PAGES=10
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
CLAMAV_REQUIRED=false
UPLOAD_DIR=private_uploads

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_TIMEOUT_MS=30000
AI_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_MS=60000
AI_DAILY_QUOTA=50
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_OPEN_MS=60000
AI_LOG_RETENTION_DAYS=30
AI_STORE_SENSITIVE_BY_DEFAULT=false

ALLOW_ADMIN_REGISTER=false
